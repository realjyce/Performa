<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Performa.Desktop.ViewModels"
             x:Class="Performa.Desktop.Views.ServingView"
             x:DataType="vm:ServingViewModel">

  <ScrollViewer>
    <StackPanel Margin="34,26,34,34" Spacing="20">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Text="Serving" Classes="h1" />
          <TextBlock Text="Everything wanting you, most pressing first." Classes="muted" />
        </StackPanel>
        <Button Grid.Column="1" Classes="ghost" Content="Refresh" VerticalAlignment="Center"
                Command="{Binding RefreshCommand}" />
      </Grid>

      <!-- The answer, before the list. Someone opening this page wants to be
           told one thing, not handed a board to read. -->
      <Border Classes="card" Padding="22,20">
        <StackPanel Spacing="10">
          <TextBlock Text="{Binding Headline}" Classes="h2 settling"
                     Classes.waiting="{Binding Settling}"
                     TextWrapping="Wrap" LineHeight="27" />
          <TextBlock Text="{Binding Window}" Classes="muted"
                     IsVisible="{Binding Window, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <!-- Generated prose always says what generated it. -->
          <TextBlock Text="{Binding Source}" Classes="faint mono" FontSize="11"
                     IsVisible="{Binding Source, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
      </Border>

      <Border Classes="card" IsVisible="{Binding !HasRows}" Padding="26">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Path Data="{DynamicResource IconCheck}" Fill="{DynamicResource PositiveBrush}"
                Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" />
          <TextBlock Text="Nothing waiting" Classes="h2" HorizontalAlignment="Center" />
          <TextBlock Text="Add something on Daily and it will be ranked here."
                     Classes="muted" HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ServingRow">
            <Border Classes="card hover" Margin="0,0,0,10" Padding="16,13">
              <StackPanel Spacing="0">
                <Grid ColumnDefinitions="4,*,Auto,Auto,Auto" ColumnSpacing="14">

                  <!-- Only the pressing rows carry the accent. Colouring every
                       row by urgency is a ramp, and a ramp has no top. -->
                  <Border Grid.Column="0" CornerRadius="2"
                          Background="{DynamicResource AccentBrush}"
                          IsVisible="{Binding IsPressing}" />

                  <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Text}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <!-- Which stream this came from. Without it a meeting and
                           a task look like the same kind of thing. -->
                      <TextBlock Text="{Binding KindLabel}" Classes="label" FontSize="9.5"
                                 VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Why}" Classes="faint" FontSize="11" />
                    </StackPanel>
                  </StackPanel>

                  <Button Grid.Column="2" Classes="ghost" Content="How?"
                          IsVisible="{Binding IsTask}"
                          Command="{Binding $parent[ItemsControl].((vm:ServingViewModel)DataContext).HowCommand}"
                          CommandParameter="{Binding}" VerticalAlignment="Center" />
                  <Button Grid.Column="3" Classes="ghost" Content="Later"
                          IsVisible="{Binding IsTask}"
                          Command="{Binding $parent[ItemsControl].((vm:ServingViewModel)DataContext).DeferCommand}"
                          CommandParameter="{Binding}" VerticalAlignment="Center" />
                  <Button Grid.Column="4" Classes="accent" Content="Done"
                          IsVisible="{Binding IsTask}"
                          Command="{Binding $parent[ItemsControl].((vm:ServingViewModel)DataContext).DoneCommand}"
                          CommandParameter="{Binding}" VerticalAlignment="Center" />
                  <Button Grid.Column="4" Classes="ghost" Content="{Binding OpenLabel}"
                          IsVisible="{Binding CanOpen}"
                          Command="{Binding $parent[ItemsControl].((vm:ServingViewModel)DataContext).OpenCommand}"
                          CommandParameter="{Binding}" VerticalAlignment="Center" />
                </Grid>

                <!-- First moves, asked for one task at a time. -->
                <Border Margin="18,12,0,0" Padding="14,11" CornerRadius="7"
                        Background="{DynamicResource BgInsetBrush}"
                        IsVisible="{Binding HasSteps}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Steps}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextMutedBrush}" LineHeight="21" />
                    <TextBlock Text="{Binding StepsSource}" Classes="faint mono" FontSize="10"
                               IsVisible="{Binding HasStepsSource}" />
                  </StackPanel>
                </Border>

                <TextBlock Text="Working it out..." Classes="faint" FontSize="11"
                           Margin="18,10,0,0" IsVisible="{Binding Thinking}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- A question about this page, answered on this page. The Assistant
           answers about the repositories; this one has the ranked list and the
           free time, so "what fits before the standup" is answerable. -->
      <Border Classes="card" Padding="18,16" IsVisible="{Binding HasRows}">
        <StackPanel Spacing="11">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBox Grid.Column="0" Text="{Binding Ask}"
                     PlaceholderText="What can I finish before my next meeting?">
              <TextBox.KeyBindings>
                <KeyBinding Gesture="Enter" Command="{Binding AskCommand}" />
              </TextBox.KeyBindings>
            </TextBox>
            <Button Grid.Column="1" Classes="accent" Content="Ask"
                    Command="{Binding AskCommand}" />
          </Grid>

          <TextBlock Text="Thinking…" Classes="faint" FontSize="11"
                     IsVisible="{Binding Asking}" />

          <Border Padding="14,12" CornerRadius="7" IsVisible="{Binding HasAnswer}"
                  Background="{DynamicResource BgInsetBrush}">
            <TextBlock Text="{Binding Answer}" TextWrapping="Wrap" LineHeight="21"
                       Foreground="{DynamicResource TextMutedBrush}" />
          </Border>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
