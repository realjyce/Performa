<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Performa.Desktop.ViewModels"
             x:Class="Performa.Desktop.Views.PullsView"
             x:DataType="vm:PullsViewModel">

  <UserControl.Resources>
    <!-- One row template shared by both lists so they can never drift apart -->
    <DataTemplate x:Key="WorkRow" x:DataType="vm:WorkItemRow">
      <Button Classes="workrow"
              Command="{Binding $parent[ItemsControl].((vm:PullsViewModel)DataContext).OpenCommand}"
              CommandParameter="{Binding}">
        <Grid ColumnDefinitions="52,170,*,64" ColumnSpacing="10">
          <Border Grid.Column="0" Classes="chip" HorizontalAlignment="Left"
                  VerticalAlignment="Center">
            <TextBlock Text="{Binding Number}" Classes="mono" FontSize="10.5" />
          </Border>
          <TextBlock Grid.Column="1" Text="{Binding Repo}" Classes="faint" FontSize="11.5"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="2" Text="{Binding Title}"
                     Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                     VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <TextBlock Grid.Column="3" Text="{Binding Updated}" Classes="faint" FontSize="11"
                     VerticalAlignment="Center" HorizontalAlignment="Right" />
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="34,26,34,34" Spacing="18">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Text="Pulls" Classes="h1" />
          <TextBlock Text="{Binding Status}" Classes="muted" TextWrapping="Wrap" MaxWidth="700"
                     HorizontalAlignment="Left" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center" IsVisible="{Binding Connected}">
          <TextBlock Text="{Binding LastRefreshed}" Classes="faint" FontSize="10.5"
                     VerticalAlignment="Center"
                     IsVisible="{Binding LastRefreshed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Button Classes="spin" Classes.busy="{Binding IsLoading}"
                  ToolTip.Tip="Refresh (auto every 5 minutes)"
                  Command="{Binding RefreshCommand}">
            <Viewbox Width="16" Height="16">
              <Panel Width="24" Height="24">
                <Path Data="{DynamicResource IconRefresh}" Fill="{DynamicResource TextMutedBrush}" />
              </Panel>
            </Viewbox>
          </Button>
        </StackPanel>
      </Grid>

      <StackPanel Spacing="8" IsVisible="{Binding HasPulls}">
        <TextBlock Text="PULL REQUESTS" Classes="label" />
        <Border Classes="card" Padding="8">
          <ItemsControl ItemsSource="{Binding Pulls}" ItemTemplate="{StaticResource WorkRow}" />
        </Border>
      </StackPanel>

      <StackPanel Spacing="8" IsVisible="{Binding HasIssues}">
        <TextBlock Text="ISSUES" Classes="label" />
        <Border Classes="card" Padding="8">
          <ItemsControl ItemsSource="{Binding Issues}" ItemTemplate="{StaticResource WorkRow}" />
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
