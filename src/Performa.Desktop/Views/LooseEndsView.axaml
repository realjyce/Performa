<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Performa.Desktop.ViewModels"
             x:Class="Performa.Desktop.Views.LooseEndsView"
             x:DataType="vm:LooseEndsViewModel">

  <ScrollViewer>
    <StackPanel Margin="34,26,34,34" Spacing="20">

      <StackPanel Spacing="3">
        <TextBlock Text="Loose Ends" Classes="h1" />
        <TextBlock Text="{Binding Summary}" Classes="muted" />
      </StackPanel>

      <Border Classes="card" IsVisible="{Binding IsClean}" Padding="26">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <Path Data="{DynamicResource IconCheck}" Fill="{DynamicResource PositiveBrush}"
                Width="26" Height="26" Stretch="Uniform" HorizontalAlignment="Center" />
          <TextBlock Text="All clear" Classes="h2" HorizontalAlignment="Center" />
          <TextBlock Text="Nothing here yet, maybe come back later?" Classes="muted"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <!-- The actionable list leads; each finding carries its next step -->
      <ItemsControl ItemsSource="{Binding Items}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LooseEndItem">
            <Border Classes="card hover" Margin="0,0,0,10" Padding="16,13">
              <Grid ColumnDefinitions="Auto,110,*">
                <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                         Margin="0,0,13,0" Fill="{DynamicResource WarningBrush}" />
                <Border Grid.Column="1" Classes="chip" VerticalAlignment="Center"
                        HorizontalAlignment="Left" Margin="0,0,13,0" MaxWidth="100">
                  <TextBlock Text="{Binding Kind}" Classes="mono" FontSize="11"
                             TextTrimming="CharacterEllipsis" />
                </Border>
                <StackPanel Grid.Column="2" Spacing="3">
                  <TextBlock Text="{Binding Text}" Classes="muted" FontSize="13"
                             TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding Advice}" Classes="faint" FontSize="11.5"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <!-- Per-repo verdicts close the page: state, not action -->
      <StackPanel Spacing="8">
        <TextBlock Text="WORKSPACE HEALTH" Classes="label" />
        <Border Classes="card" Padding="16,10">
          <ItemsControl ItemsSource="{Binding Health}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RepoHealthRow">
                <Grid ColumnDefinitions="16,140,110,*" Margin="0,5" ColumnSpacing="10">
                  <Path Grid.Column="0" Data="{DynamicResource IconCheck}"
                        Fill="{DynamicResource PositiveBrush}" Width="12" Height="12"
                        Stretch="Uniform" VerticalAlignment="Center"
                        IsVisible="{Binding Clean}" />
                  <Ellipse Grid.Column="0" Width="8" Height="8" VerticalAlignment="Center"
                           HorizontalAlignment="Center" Fill="{DynamicResource WarningBrush}"
                           IsVisible="{Binding !Clean}" />
                  <TextBlock Grid.Column="1" Text="{Binding Name}"
                             Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"
                             VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                  <Border Grid.Column="2" Classes="chip" HorizontalAlignment="Left"
                          VerticalAlignment="Center">
                    <TextBlock Text="{Binding Branch}" Classes="mono" FontSize="10.5"
                               TextTrimming="CharacterEllipsis" />
                  </Border>
                  <TextBlock Grid.Column="3" Text="{Binding Verdict}" Classes="faint"
                             FontSize="12" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>

    </StackPanel>
  </ScrollViewer>
</UserControl>
