<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Performa.Desktop.ViewModels"
             x:Class="Performa.Desktop.Views.DailyView"
             x:DataType="vm:DailyViewModel">

  <Grid Margin="34,26,34,34" RowDefinitions="Auto,*">

    <StackPanel Grid.Row="0" Spacing="14" Margin="0,0,0,20">
      <StackPanel Spacing="3">
        <TextBlock Text="{Binding Salutation}" Classes="h1" />
        <TextBlock Text="{Binding Today}" Classes="muted" />
      </StackPanel>

      <!-- The day in one paragraph. Facts first; a model only rewrites them. -->
      <Border Classes="card" Padding="18,14" IsVisible="{Binding HasBrief}">
        <StackPanel Spacing="8">
          <TextBlock Text="{Binding Brief}" Classes="muted" FontSize="13.5"
                     TextWrapping="Wrap" LineHeight="21" />
          <StackPanel Orientation="Horizontal" Spacing="6"
                      IsVisible="{Binding BriefSource, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <Ellipse Width="4" Height="4" VerticalAlignment="Center"
                     Fill="{DynamicResource TextFaintBrush}" />
            <TextBlock Text="{Binding BriefSource}" Classes="mono" FontSize="10"
                       Foreground="{DynamicResource TextFaintBrush}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Written by the automation loop at the end of the day; always stamped -->
      <Border Padding="18,14" CornerRadius="12" IsVisible="{Binding HasCloseout}"
              Background="{DynamicResource AccentSoftBrush}"
              BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
        <StackPanel Spacing="7">
          <TextBlock Text="CLOSE-OUT" Classes="label"
                     Foreground="{DynamicResource AccentBrightBrush}" />
          <TextBlock Text="{Binding Closeout}" Classes="muted" FontSize="13.5"
                     TextWrapping="Wrap" LineHeight="21" />
          <TextBlock Text="{Binding CloseoutStamp}" Classes="mono" FontSize="10"
                     Foreground="{DynamicResource TextFaintBrush}" />
        </StackPanel>
      </Border>
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="*,360" ColumnSpacing="18">

      <!-- Left: tasks + notes -->
      <Grid Grid.Column="0" RowDefinitions="Auto,*" RowSpacing="16">

        <Border Grid.Row="0" Classes="card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="Auto,*,Auto">
              <TextBlock Grid.Column="0" Text="TASKS" Classes="label"
                         VerticalAlignment="Center" />
              <!-- A ratio against a limit: a meter, not a two-slice donut. -->
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                          VerticalAlignment="Center" IsVisible="{Binding HasTasks}">
                <TextBlock Text="{Binding TaskProgress}" Classes="faint" FontSize="11"
                           VerticalAlignment="Center" />
                <Panel Width="150" VerticalAlignment="Center">
                  <Border Classes="metertrack" />
                  <Border Classes="meterfill" Width="150" RenderTransform="{Binding TaskMeterFill}" />
                </Panel>
              </StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
              <TextBox Grid.Column="0" Text="{Binding NewTaskText}"
                       PlaceholderText="Add a task, or &quot;ship the readme friday&quot;…">
                <TextBox.KeyBindings>
                  <KeyBinding Gesture="Enter" Command="{Binding AddTaskCommand}" />
                </TextBox.KeyBindings>
              </TextBox>
              <Button Grid.Column="1" Classes="accent" Content="Add"
                      Command="{Binding AddTaskCommand}" />
            </Grid>
            <ItemsControl ItemsSource="{Binding Tasks}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:TaskRow">
                  <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                    <CheckBox Grid.Column="0" IsChecked="{Binding Done}">
                      <StackPanel Orientation="Horizontal" Spacing="9">
                        <TextBlock Text="{Binding Text}" Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center" TextWrapping="Wrap" />
                        <!-- Serving sorts on this, so Daily has to show it or the
                             order over there looks arbitrary from here. -->
                        <TextBlock Text="{Binding DueLabel}" Classes="faint" FontSize="11"
                                   VerticalAlignment="Center" IsVisible="{Binding HasDue}" />
                      </StackPanel>
                    </CheckBox>
                    <!-- Distinct from ticking: done is work that happened,
                         delete is work that will not. Conflating them makes the
                         close-out count things nobody did. -->
                    <Button Grid.Column="1" Classes="ghost" Content="✕" FontSize="11"
                            Padding="7,2" VerticalAlignment="Center"
                            Command="{Binding $parent[ItemsControl].((vm:DailyViewModel)DataContext).DeleteTaskCommand}"
                            CommandParameter="{Binding}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Harvested from your inbox. Suggestions, never silent additions. -->
            <StackPanel Spacing="7" IsVisible="{Binding HasSuggestions}">
              <Border Height="1" Background="{DynamicResource BorderSoftBrush}" />
              <TextBlock Text="FROM YOUR INBOX" Classes="label"
                         Foreground="{DynamicResource AccentBrightBrush}" />
              <ItemsControl ItemsSource="{Binding Suggestions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="6" Margin="0,2">
                      <TextBlock Grid.Column="0" Text="{Binding}" Classes="muted"
                                 FontSize="12.5" VerticalAlignment="Center"
                                 TextWrapping="Wrap" />
                      <Button Grid.Column="1" Classes="ghost" Content="Add" FontSize="11"
                              Padding="9,4" VerticalAlignment="Center"
                              Command="{Binding $parent[ItemsControl].((vm:DailyViewModel)DataContext).AcceptSuggestionCommand}"
                              CommandParameter="{Binding}" />
                      <Button Grid.Column="2" Classes="ghost" Content="✕" FontSize="11"
                              Padding="8,4" VerticalAlignment="Center"
                              ToolTip.Tip="Dismiss for good"
                              Command="{Binding $parent[ItemsControl].((vm:DailyViewModel)DataContext).DismissSuggestionCommand}"
                              CommandParameter="{Binding}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Grid.Row="1" Classes="card">
          <DockPanel>
            <TextBlock DockPanel.Dock="Top" Text="NOTES" Classes="label" Margin="0,0,0,10" />
            <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap"
                     PlaceholderText="Jot down anything about today…"
                     Background="Transparent" BorderThickness="0"
                     VerticalAlignment="Stretch" VerticalContentAlignment="Top" />
          </DockPanel>
        </Border>

      </Grid>

      <!-- Right: schedule + commits -->
      <ScrollViewer Grid.Column="1">
        <StackPanel Spacing="16">

          <Border Classes="card">
            <StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="9"
                            VerticalAlignment="Center">
                  <TextBlock Text="SCHEDULE" Classes="label" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding FocusNote}" Classes="label" VerticalAlignment="Center"
                             IsVisible="{Binding HasFocusNote}"
                             Foreground="{DynamicResource AccentBrightBrush}" />
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding LastRefreshed}" Classes="faint"
                           FontSize="10.5" VerticalAlignment="Center" Margin="0,0,8,0"
                           IsVisible="{Binding LastRefreshed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <Button Grid.Column="2" Classes="spin" Classes.busy="{Binding IsRefreshing}"
                        IsVisible="{Binding GoogleConnected}"
                        ToolTip.Tip="Refresh (auto every 5 minutes)"
                        Command="{Binding RefreshCalendarCommand}">
                  <Viewbox Width="16" Height="16">
              <Panel Width="24" Height="24">
                <Path Data="{DynamicResource IconRefresh}" Fill="{DynamicResource TextMutedBrush}" />
              </Panel>
            </Viewbox>
                </Button>
              </Grid>

              <TextBlock Text="{Binding CalendarStatus}" Classes="faint" TextWrapping="Wrap"
                         IsVisible="{Binding CalendarStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

              <ItemsControl ItemsSource="{Binding Events}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:EventCard">
                   <StackPanel>
                    <!-- The clear run in front of this event. Drawn as its own
                         line because the gap is the part you can spend. -->
                    <Grid ColumnDefinitions="3,*" Margin="0,0,0,10" IsVisible="{Binding HasGap}">
                      <Border Grid.Column="0" CornerRadius="2"
                              Background="{DynamicResource AccentSoftBrush}" />
                      <TextBlock Grid.Column="1" Text="{Binding GapBefore}" Margin="11,0,0,0"
                                 Classes="faint" FontSize="11.5" VerticalAlignment="Center"
                                 Foreground="{DynamicResource AccentBrightBrush}" />
                    </Grid>
                    <Grid ColumnDefinitions="3,*" Margin="0,0,0,12">
                      <!-- colour node from your own Google palette -->
                      <Border Grid.Column="0" Background="{Binding Colour}" CornerRadius="2" />
                      <StackPanel Grid.Column="1" Spacing="2" Margin="11,0,0,0">
                        <TextBlock Text="{Binding Title}"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   FontSize="13" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="7">
                          <TextBlock Text="{Binding Day}" Classes="faint" FontSize="11" />
                          <TextBlock Text="{Binding Time}" Classes="mono" FontSize="11" />
                        </StackPanel>
                        <TextBlock Text="{Binding Location}" Classes="faint" FontSize="11"
                                   IsVisible="{Binding HasLocation}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Grid>
                   </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

          <Border Classes="card">
            <StackPanel Spacing="12">
              <TextBlock Text="TODAY'S COMMITS" Classes="label" />
              <TextBlock Text="{Binding TimelineEmpty}" Classes="faint"
                         IsVisible="{Binding TimelineEmpty, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
              <ItemsControl ItemsSource="{Binding Timeline}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:TimelineRow">
                    <!-- Fixed first column so every subject starts at the same x -->
                    <Grid ColumnDefinitions="72,*" Margin="0,0,0,12">
                      <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Time}" Classes="mono" FontSize="12"
                                   Foreground="{DynamicResource AccentBrightBrush}" />
                        <TextBlock Text="{Binding Repo}" Classes="faint" FontSize="10"
                                   TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Subject}" Classes="muted"
                                 FontSize="12.5" TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </Border>

        </StackPanel>
      </ScrollViewer>

    </Grid>
  </Grid>
</UserControl>
