<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Performa.Desktop.ViewModels"
             x:Class="Performa.Desktop.Views.ActivityView"
             x:DataType="vm:ActivityViewModel">

  <ScrollViewer>
    <StackPanel Margin="34,26,34,34" Spacing="20">

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel Grid.Column="0" Spacing="3">
          <TextBlock Text="Activity" Classes="h1" />
          <TextBlock Text="{Binding Summary}" Classes="muted" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding LastRefreshed}" Classes="faint" FontSize="10.5"
                     VerticalAlignment="Center"
                     IsVisible="{Binding LastRefreshed, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          <Button Classes="spin" Classes.busy="{Binding IsLoading}"
                  ToolTip.Tip="Refresh (auto every 5 minutes)"
                  Command="{Binding RefreshCommand}">
            <Viewbox Width="16" Height="16">
              <Panel Width="24" Height="24">
                <Path Data="{DynamicResource IconRefresh}" Fill="{DynamicResource TextMutedBrush}" />
              </Panel>
            </Viewbox>
          </Button>
        </StackPanel>
      </Grid>

      <Border Classes="card" IsVisible="{Binding IsEmpty}" Padding="26">
        <StackPanel Spacing="8" HorizontalAlignment="Center">
          <TextBlock Text="Nothing here yet" Classes="h2" HorizontalAlignment="Center" />
          <TextBlock Text="Commits you make will build up a trail here." Classes="muted"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding Days}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ActivityDay">
            <StackPanel Spacing="8" Margin="0,0,0,16">
              <Grid ColumnDefinitions="Auto,Auto">
                <TextBlock Grid.Column="0" Text="{Binding Title}" Classes="h2" FontSize="14" />
                <TextBlock Grid.Column="1" Text="{Binding Count}" Classes="faint" FontSize="11"
                           VerticalAlignment="Bottom" Margin="10,0,0,2" />
              </Grid>
              <Border Classes="card" Padding="16,12">
                <ItemsControl ItemsSource="{Binding Commits}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActivityCommit">
                      <!-- Fixed columns: every subject starts at the same x,
                           however long the repo name is. -->
                      <Grid ColumnDefinitions="44,104,*" Margin="0,4">
                        <TextBlock Grid.Column="0" Text="{Binding Time}" Classes="mono"
                                   FontSize="11.5"
                                   Foreground="{DynamicResource AccentBrightBrush}"
                                   VerticalAlignment="Center" />
                        <Border Grid.Column="1" Classes="chip" Margin="0,0,10,0"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                MaxWidth="94">
                          <TextBlock Text="{Binding Repo}" Classes="mono" FontSize="10.5"
                                     TextTrimming="CharacterEllipsis" />
                        </Border>
                        <TextBlock Grid.Column="2" Text="{Binding Subject}" Classes="muted"
                                   FontSize="12.5" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </Border>
            </StackPanel>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>
</UserControl>
