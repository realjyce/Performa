<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Performa.Desktop.Infrastructure">

  <!-- Every scroll surface glides instead of stepping -->
  <Style Selector="ScrollViewer">
    <Setter Property="(infra:SmoothScroll.IsEnabled)" Value="True" />
  </Style>

  <!-- Card container -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="18" />
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadow}" />
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.18" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Border.card.hover:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderStrongBrush}" />
    <Setter Property="BoxShadow" Value="{DynamicResource CardShadowRaised}" />
  </Style>

  <!-- Section + heading text -->
  <Style Selector="TextBlock.h1">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.h2">
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="FontSize" Value="16" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="LetterSpacing" Value="1.2" />
  </Style>
  <Style Selector="TextBlock.muted">
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock.faint">
    <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="FontSize" Value="12" />
  </Style>

  <!-- Nav item button -->
  <Style Selector="RadioButton.nav">
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="root" Background="Transparent" CornerRadius="9" Padding="12,9"
                Margin="0,1">
          <ContentPresenter Content="{TemplateBinding Content}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="RadioButton.nav /template/ Border#root:pointerover">
    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
  </Style>
  <Style Selector="RadioButton.nav:checked /template/ Border#root">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <!-- Accent button -->
  <Style Selector="Button.accent">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="16,9" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <!--
    Fluent's button template paints the ContentPresenter from its own resource,
    which beats Background set on the button. Without these the accent buttons
    silently fall back to the system blue instead of Performa's violet.
  -->
  <Style Selector="Button.accent /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.accent:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrightBrush}" />
  </Style>
  <Style Selector="Button.accent:pressed /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>
  <!--
    Press feedback. Reverting the background is not an acknowledgement: the
    button ends up looking exactly as it did at rest while the pointer is
    still down. A small scale is the part the hand reads.
  -->
  <Style Selector="Button.accent">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.accent:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Padding" Value="14,8" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource TextPrimaryBrush}" />
  </Style>
  <Style Selector="Button.ghost">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.14" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.ghost:pressed">
    <Setter Property="RenderTransform" Value="scale(0.97)" />
  </Style>

  <!--
    The headline on Serving. It is replaced when the model finishes, and a
    sentence swapping in place is read as a glitch rather than an answer, so it
    dims while the model is out and comes back up with the new text.
  -->
  <Style Selector="TextBlock.settling">
    <Setter Property="Transitions">
      <Transitions>
        <DoubleTransition Property="Opacity" Duration="0:0:0.26" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="TextBlock.settling.waiting">
    <Setter Property="Opacity" Value="0.25" />
  </Style>

  <!-- A ghost button that is currently the active choice. Filled rather than
       merely outlined: an outline against an outline is a difference you have
       to look for, and the whole job of this state is to be found. -->
  <Style Selector="Button.ghost.picked /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="TextElement.Foreground" Value="{DynamicResource AccentBrightBrush}" />
  </Style>

  <!-- Quick-action card button -->
  <Style Selector="Button.qcard">
    <Setter Property="Background" Value="{DynamicResource BgCardBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="16" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.qcard:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!--
    Inputs are a bare caret on the card, the way a terminal prompt is: no box,
    no border, nothing that lights up on hover or focus. The card around them
    is the container, so a second container inside it is just noise.
  -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    <Setter Property="SelectionBrush" Value="{DynamicResource AccentSoftBrush}" />
    <Setter Property="CaretBrush" Value="{DynamicResource AccentBrightBrush}" />
  </Style>

  <!-- Fluent draws focus as a thick accent underline inside the template. -->
  <Style Selector="TextBox /template/ Border#PART_BorderElement">
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!--
    Dropdowns: the popup is pinned to the button's own width so a long option
    can never make the list wider than the control it drops out of. Options
    trim rather than wrap, which keeps every row one line tall.
  -->
  <Style Selector="ComboBox">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,7" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="ComboBox /template/ Border#Background">
    <Setter Property="CornerRadius" Value="8" />
  </Style>

  <Style Selector="ComboBox /template/ Border#PopupBorder">
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Padding" Value="3" />
    <Setter Property="Margin" Value="0,4,0,0" />
  </Style>

  <Style Selector="ComboBox /template/ Popup#PART_Popup">
    <Setter Property="Width" Value="{Binding $parent[ComboBox].Bounds.Width}" />
  </Style>

  <Style Selector="ComboBoxItem">
    <Setter Property="Padding" Value="10,7" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="ComboBoxItem TextBlock">
    <Setter Property="TextWrapping" Value="NoWrap" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <!-- Circular refresh affordance -->
  <Style Selector="Button.spin">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.spin:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
  </Style>
  <!--
    The icon geometry's bounding box is taller than wide, so rotating the Path
    itself wobbles: the shape's envelope sweeps off-centre. Rotating the square
    Viewbox instead pivots on the glyph's true circle centre, whatever the
    geometry's own bounds are.
  -->
  <Style Selector="Button.spin Viewbox">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
  </Style>
  <Style Selector="Button.spin.busy Viewbox">
    <Style.Animations>
      <Animation Duration="0:0:1.1" IterationCount="INFINITE" Easing="LinearEasing">
        <KeyFrame Cue="0%"><Setter Property="RotateTransform.Angle" Value="0" /></KeyFrame>
        <KeyFrame Cue="100%"><Setter Property="RotateTransform.Angle" Value="360" /></KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>

  <!--
    Chart column. Per the mark spec: capped thickness so the slot keeps its air,
    a 4px rounded data-end that stays square on the baseline, and no stroke -
    the 2px margin in the surface colour is what separates neighbours.
  -->
  <Style Selector="Border.daybar">
    <Setter Property="Background" Value="{DynamicResource BarRestBrush}" />
    <Setter Property="CornerRadius" Value="4,4,0,0" />
    <Setter Property="MaxWidth" Value="24" />
    <Setter Property="RenderTransformOrigin" Value="50%,100%" />
    <!-- Grows from the baseline once, on load: the chart arrives rather than
         appearing. Styles apply per element, so each bar runs its own. -->
    <Style.Animations>
      <Animation Duration="0:0:0.45" Easing="CubicEaseOut" FillMode="Forward">
        <KeyFrame Cue="0%">
          <Setter Property="ScaleTransform.ScaleY" Value="0" />
          <Setter Property="Opacity" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="ScaleTransform.ScaleY" Value="1" />
          <Setter Property="Opacity" Value="1" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
  <!-- Emphasis, not a value-ramp: today is the one bar the reader is looking for. -->
  <Style Selector="Border.daybar.today">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
  </Style>

  <!-- Meter: a ratio against a limit, on the same ramp as its track -->
  <Style Selector="Border.metertrack">
    <Setter Property="Background" Value="{DynamicResource BgInsetBrush}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Height" Value="6" />
  </Style>
  <Style Selector="Border.meterfill">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Height" Value="6" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <!-- Scales from the left edge so the fill grows out of the track's start
         rather than its middle. Width used to carry this, which relayouts the
         row on every frame of the animation; a transform does not. -->
    <Setter Property="RenderTransformOrigin" Value="0%,50%" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.4" Easing="CubicEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <!-- Sidebar workspace picker: quiet, whole block clickable -->
  <Style Selector="Button.wspick">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="6,4" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.wspick /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.wspick:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
  </Style>

  <!-- Rail collapse toggle: chevron points at where the rail will go -->
  <Style Selector="Button.railtoggle">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>
  <Style Selector="Button.railtoggle /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="16" />
  </Style>
  <Style Selector="Button.railtoggle:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
  </Style>
  <Style Selector="Button.railtoggle Path">
    <Setter Property="RenderTransformOrigin" Value="50%,50%" />
    <Setter Property="RenderTransform" Value="rotate(90deg)" />
    <Setter Property="Transitions">
      <Transitions>
        <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.18" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="Button.railtoggle.flipped Path">
    <Setter Property="RenderTransform" Value="rotate(-90deg)" />
  </Style>

  <!-- Collapsed rail: any .rail container hides its labels, icons remain -->
  <Style Selector=".rail TextBlock.navtitle">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector=".rail Border.navchip">
    <Setter Property="IsVisible" Value="False" />
  </Style>
  <Style Selector="Button.assistantcard.rail">
    <Setter Property="Padding" Value="11,12" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>

  <!-- Clickable list row: flat until hovered, stretches full width -->
  <Style Selector="Button.workrow">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Cursor" Value="Hand" />
  </Style>
  <Style Selector="Button.workrow /template/ ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Button.workrow:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
  </Style>

  <!-- Assistant: the one premium surface in the sidebar -->
  <Style Selector="Button.assistantcard">
    <Setter Property="Background" Value="{DynamicResource AssistantGradient}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="14,13" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
  </Style>
  <Style Selector="Button.assistantcard:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource AssistantGradient}" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>

  <!-- Pill / chip -->
  <Style Selector="Border.chip">
    <Setter Property="Background" Value="{DynamicResource BgInsetBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderSoftBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="20" />
    <Setter Property="Padding" Value="10,3" />
  </Style>

  <!-- Sidebar nav list -->
  <Style Selector="ListBox.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,1" />
    <Setter Property="CornerRadius" Value="9" />
    <Setter Property="Template">
      <ControlTemplate>
        <Border Name="root" Background="{TemplateBinding Background}"
                CornerRadius="9" Padding="11,9">
          <ContentPresenter Content="{TemplateBinding ContentPresenter.Content}"
                            ContentTemplate="{TemplateBinding ContentPresenter.ContentTemplate}" />
        </Border>
      </ControlTemplate>
    </Setter>
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.15" />
      </Transitions>
    </Setter>
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:pointerover /template/ Border#root">
    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
  </Style>
  <Style Selector="ListBox.nav ListBoxItem:selected /template/ Border#root">
    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
  </Style>

  <!-- Window control buttons -->
  <Style Selector="Button.wbtn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Width" Value="44" />
    <Setter Property="Height" Value="34" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button.wbtn:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource BgCardHoverBrush}" />
  </Style>
  <Style Selector="Button.wclose:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
  </Style>

</Styles>
